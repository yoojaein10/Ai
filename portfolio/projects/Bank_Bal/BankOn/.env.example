# BankOn 설정 — 실제 값은 .env 에 넣고 절대 커밋하지 않는다.

# 원천 조회용 SQL Server (읽기 전용) — apworksdw
SOURCE_SQL_SERVER=
SOURCE_SQL_DATABASE=apworksdw
SOURCE_SQL_USER=
SOURCE_SQL_PASSWORD="example"

# 감정서 파일 FTP (BonJisa)
FTP_HOST=
FTP_USER=
FTP_PASSWORD="example"

# .gam 추출기 (GamJun 의 delphi/gamexport.exe 경로)
# 아래 경로 3개는 단일 exe 배포에선 비워 둠(번들 gamexport + exe 옆 work/·output/)
GAMEXPORT_EXE=

# 작업 폴더
WORK_DIR=
OUTPUT_DIR=

# 사업등록번호 (본사 고정값)
BUSINESS_NUMBER=2148746436

# 등기번호 보완용 appraisal DB (선택 — 비우면 건너뜀. 본사 건만 72% 보유)
SCAN_SQL_SERVER=
SCAN_SQL_DATABASE=appraisal
SCAN_SQL_USER=
SCAN_SQL_PASSWORD="example"

# 1=입력 후 '저 장' 버튼까지 누름(발송 아님). 0=필드만 채우고 저장은 사람이.
AUTO_SUBMIT=1

# 1=처리 후 다운로드 원본 유지(디버깅용)
KEEP_SOURCE_FILES=0
