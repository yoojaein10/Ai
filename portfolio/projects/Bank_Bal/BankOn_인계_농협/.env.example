# BankOn 접속·경로 설정 — 이 파일을 `.env` 로 복사한 뒤 값을 채우세요.
# ★ 서버 주소·계정은 비워 두었습니다. 담당자에게 받으세요.
#
# ★ 경로는 **UNC 로** 적으세요(`\\서버\공유\...`). BANK24 가 관리자 권한으로 도는데,
#   매핑 드라이브(Y: 등)는 로그온 세션마다 따로여서 관리자 프로세스에는 안 보입니다
#   → gamexport 가 [WinError 2] 로 죽습니다.

# 원천 감정 DB — 문서·지번·평가사·수수료
SOURCE_SQL_SERVER=
SOURCE_SQL_DATABASE=
SOURCE_SQL_USER=
SOURCE_SQL_PASSWORD="example"

# 공부스캔 DB — 등기번호(T_SCAN_GONGBU). 비워 두면 등기번호 보완만 건너뜁니다.
SCAN_SQL_SERVER=
SCAN_SQL_DATABASE=
SCAN_SQL_USER=
SCAN_SQL_PASSWORD="example"

# (선택) 적재용 DB — 검증만 할 거면 비워 두세요.
TARGET_SQL_SERVER=
TARGET_SQL_DATABASE=
TARGET_SQL_USER=
TARGET_SQL_PASSWORD="example"

# FTP — .gam 감정서 다운로드
FTP_HOST=
FTP_USER=
FTP_PASSWORD="example"

# 추출기·작업 경로
GAMEXPORT_EXE=./bin/gamexport.exe
WORK_DIR=./work
OUTPUT_DIR=./output
OPINION_DIR=
KEEP_SOURCE_FILES=0
BUSINESS_NUMBER=2148746436

# BANK24 자동 로그인 — **비워 두어도 됩니다.** 검증·대조 도구는 사람이 띄워 둔 화면을
# 읽기만 하므로 이 셋이 없어도 돕니다(`bankon.cli` 로 직접 띄울 때만 필요).
BANKON_LOADER_CMD=
BANKON_USER=
BANKON_PASSWORD="example"
