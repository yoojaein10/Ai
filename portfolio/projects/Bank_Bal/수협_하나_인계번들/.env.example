# BankOn 접속/경로 설정 — 실제 값 채워서 `.env` 로 저장하세요 (이 파일은 템플릿, 값 비어있음).

# 원천 감정 DB (apworksdw) — 문서·지번·평가사·수수료
SOURCE_SQL_SERVER=192.0.2.10,1433
SOURCE_SQL_DATABASE=
SOURCE_SQL_USER=
SOURCE_SQL_PASSWORD="example"

# 공부스캔 DB (appraisal) — 등기번호(T_SCAN_GONGBU)
SCAN_SQL_SERVER=192.0.2.10,1433
SCAN_SQL_DATABASE=
SCAN_SQL_USER=
SCAN_SQL_PASSWORD="example"

# (선택) DW 적재용 — 검증엔 불필요
TARGET_SQL_SERVER=
TARGET_SQL_DATABASE=
TARGET_SQL_USER=
TARGET_SQL_PASSWORD="example"

# FTP (BonJisa) — .gam 다운로드
FTP_HOST=192.0.2.10
FTP_USER=
FTP_PASSWORD="example"

# 추출기·작업 경로 — 이 PC 기준으로 수정
GAMEXPORT_EXE=./bin/gamexport.exe
WORK_DIR=./work
OUTPUT_DIR=./output
OPINION_DIR=
KEEP_SOURCE_FILES=0
BUSINESS_NUMBER=2148746436

# (선택) BANK24 자동 로그인 — 수동 로그인이면 불필요
BANKON_LOADER_CMD=
BANKON_USER=
BANKON_PASSWORD="example"
