# ─── 운영 환경변수 템플릿 ────────────────────────────────
# 이 파일을 .env로 복사한 뒤 실제 값으로 채운다.
# 절대 git에 커밋하지 말 것 (.env는 .gitignore 처리됨).

# ── 인사 DB (운영용 — 개발 DB 192.0.2.10/insa 와 별도) ──
DB_HOST=
DB_PORT=1433
DB_NAME=insa
DB_USER=
DB_PASSWORD="example"
DB_DRIVER=ODBC Driver 17 for SQL Server

# ── 근태 DB (ACSDB, read-only) ──
ATT_DB_HOST=
ATT_DB_PORT=1433
ATT_DB_NAME=
ATT_DB_USER=
ATT_DB_PASSWORD="example"
ATT_DB_DRIVER=ODBC Driver 17 for SQL Server

# ── 업무시스템 DB (apworksdw: 연차/출장, read-only) ──
APW_DB_HOST=
APW_DB_PORT=1433
APW_DB_NAME=
APW_DB_USER=
APW_DB_PASSWORD="example"
APW_DB_DRIVER=ODBC Driver 17 for SQL Server

# ── JWT ──
# python -c "import secrets; print(secrets.token_urlsafe(64))" 로 생성
JWT_SECRET_KEY="example"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES="example"
REFRESH_TOKEN_EXPIRE_DAYS="example"

# ── CORS ──
# 단일 nginx 시나리오(같은 origin)면 사실상 불필요. 그래도 운영 도메인만 허용.
CORS_ORIGINS=["https://insa.example.local"]

# ── AES-256 (계좌번호 암호화 — EmpAccount.account_no_enc) ──
# 신규 키 생성: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# 키를 변경하면 기존 암호화된 모든 계좌번호 복호화 불가. 회전 정책 사전 합의.
AES_KEY="example"
