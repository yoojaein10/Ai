# Amaranth 10 - 더존에서 발급/안내받은 값만 입력합니다.
A10_BASE_URL=
A10_CALLER_NAME=
A10_ACCESS_TOKEN="example"
A10_HASH_KEY=
A10_GROUP_SEQ=

# Microsoft SQL Server
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DB=
MSSQL_SOURCE_DB=apworksdw
MSSQL_USER=
MSSQL_PASSWORD="example"
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=no

# 감정서 PDF 파싱 DB(보수기준 점검의 본문 근거). 계정은 위 MSSQL_USER/PASSWORD 재사용.
# 비워두면 아래 기본값을 쓴다.
GAMJUN_PARSE_SERVER=192.0.2.10
GAMJUN_PARSE_DB=gamjundw

# 보수기준 점검의 JUN 원문 근거(교정 텍스트·섹션) 조회 연결.
# 비워 두면 JUN 근거 없이 목적·이력 판별만 동작하고 화면에 'JUN 근거 조회 실패'가 뜬다.
# 운영에서는 반드시 채운다 — 안 채우면 근거 빈 스냅숏이 캐시된다.
# 예: mssql+pyodbc 접속 문자열 또는 접속 문자열이 담긴 파일 경로 중 하나.
JUN_SQL_CONNECTION_STRING=
JUN_SQL_CONNECTION_FILE=
JUN_SQL_DATABASE=gamjundw

# Bridge
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8010
LOG_LEVEL=INFO
# 보수검토 결과 유실을 막기 위해 운영은 false. 로컬 DDL 적용 전 확인만 true.
FEE_REVIEW_ALLOW_MEMORY_FALLBACK=false

# 카드내역 원천 DB (Branch, 카드사 API 수집) — 카드전표 '카드내역 불러오기'.
# 읽기 전용 조회만 하며, 비어 있으면 기능이 비활성화된다.
CARD_SOURCE_SERVER=
CARD_SOURCE_DB=Branch
CARD_SOURCE_USER=
CARD_SOURCE_PASSWORD="example"

# 팝빌(링크허브) 전자세금계산서. POPBILL_IS_TEST=true면 테스트 서버로만 발행.
POPBILL_LINK_ID=
POPBILL_SECRET_KEY="example"
POPBILL_CORP_NUM=
POPBILL_USER_ID=
POPBILL_IS_TEST=true
# 공급자(우리 회사) 세금계산서 표기 — 대표자명은 팝빌 필수
POPBILL_SUPPLIER_NAME=대화감정평가법인
POPBILL_SUPPLIER_CEO=
POPBILL_SUPPLIER_ADDR=
POPBILL_SUPPLIER_BIZTYPE=서비스
POPBILL_SUPPLIER_BIZCLASS=감정평가
POPBILL_SUPPLIER_TEL=
POPBILL_SUPPLIER_EMAIL=

# 협회(KAPA) 업무실적 REST 전송
KAPA_LAWREP_BASE_URL=https://m.kapanet.or.kr
KAPA_LAWREP_USER=
KAPA_LAWREP_PW=
KAPA_API_KEY="example"

# 입금내역 알림톡 (비즈뿌리오 DB 에이전트 - 같은 SQL 서버의 KakaoMMs.dbo.BIZ_MSG에 INSERT)
BIZPPURIO_SENDER_KEY=
BIZPPURIO_TEMPLATE_CODE=
BIZPPURIO_SEND_PHONE=
# 설정하면 모든 알림톡이 이 번호로만 감 (실수신자 발송 방지 - 운영 전환 시 비우기)
PAYMENT_ALERT_TEST_PHONE=
# 배치 자동 발송 스위치 (기본 false - 켜기 전까지 화면 수동 발송만)
PAYMENT_ALERT_AUTO_SEND=false
PAYMENT_ALERT_AUTO_DAYS=3
# 자동발송 운영 시작일(YYYY-MM-DD) - 이 날짜 이후 입금분만 발송. 비면 자동발송 안 함
PAYMENT_ALERT_START_DATE=

# ── 로그인 증표 (2026-08-16) ─────────────────────────────────────────────
# 권한을 **바꾸는** API 는 로그인 증표를 요구한다. 종전에는 X-MOA-USR-SEQ 헤더의
# 숫자 하나만 믿어서, 주소를 아는 사람이 재무팀 번호를 넣으면 전사 권한을
# 갈아치울 수 있었다. 조회는 종전대로라 EXE 런처는 영향이 없다.
#
# **운영에는 반드시 지정한다.** 비워 두면 서버가 뜰 때마다 임시 키를 만들어
# 쓰는데, 그러면 재기동할 때마다 권한 담당자가 다시 로그인해야 한다.
# 값은 아무나 못 맞히게 길게. 예: python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_TOKEN_SECRET="example"
# 문제가 생기면 되돌릴 손잡이. 끄면 종전처럼 헤더 숫자만으로 권한을 바꿀 수 있다.
AUTH_REQUIRE_TOKEN_FOR_WRITES="example"

# ── 메일 발송 (계정별원장 → 지사) ─────────────────────────────────────
# 하나라도 비면 발송 기능이 꺼진다(fail-closed).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD="example"
SMTP_FROM=                 # 비우면 SMTP_USER 를 쓴다
SMTP_FROM_NAME=대화감정평가법인
SMTP_USE_TLS=true          # 587 = STARTTLS
SMTP_USE_SSL=false         # 465 를 쓰면 true, USE_TLS 는 false
# 테스트 수신자 — 값이 있으면 **누구에게 보내든 여기로만** 간다.
# 지사 주소가 정리될 때까지 비우지 말 것 (2026-08-21).
LEDGER_MAIL_TEST_TO=
